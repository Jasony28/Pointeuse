// RÈGLES FIRESTORE À AJOUTER au projet « pointeuse-ldpr » (nouveautés reprises de la Pointeuse LPF).
//
// Où : console Firebase → Firestore Database → Règles. Coller les blocs ci-dessous À L'INTÉRIEUR de
// « match /databases/{database}/documents { … } », à côté des règles déjà en place, puis « Publier ».
// Ne pas remplacer les règles existantes : elles servent aux pointages, congés, planning, demandes du site…
// Si les fonctions isAdmin() / isApproved() existent déjà avec le même nom, ne pas les recopier.
//
// Si une règle générale « match /{document=**} { allow read: if … } » existe, elle laisse lire ces collections
// à tous les comptes : ajouter à cette règle une exclusion de 'pleins', 'pleinsPhotos' et 'retoursClients'
// (exemple : match /{collection}/{document=**} { allow read: if … && !(collection in ['pleins', 'pleinsPhotos', 'retoursClients']); }).

    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isApproved() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }

    // RETOURS CLIENTS : l'admin crée, annule et supprime ; chaque compte lit seulement les siens
    // (l'appli n'affiche ensuite que ceux du profil actif). L'employé peut seulement marquer « lu » (une fois)
    // puis répondre (une fois, 1000 caractères au plus).
    match /retoursClients/{retourId} {
      function own() { return isApproved() && resource.data.uid == request.auth.uid && resource.data.get('cancelled', false) == false; }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
      allow read: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (own() && (
                       (changed().hasOnly(['readAt'])
                        && resource.data.get('readAt', null) == null
                        && request.resource.data.readAt == request.time)
                    || (changed().hasOnly(['reply', 'replyAt'])
                        && resource.data.get('readAt', null) != null
                        && resource.data.get('reply', '') == ''
                        && request.resource.data.reply is string
                        && request.resource.data.reply.size() > 0
                        && request.resource.data.reply.size() <= 1000
                        && request.resource.data.replyAt == request.time)));
    }

    // PLEINS DE CARBURANT : chacun lit et supprime seulement les siens, l'admin lit et supprime tout.
    // Un plein noté ne se modifie pas (on le supprime et on le refait). La photo est à part (même identifiant).
    match /pleins/{pleinId} {
      allow read: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
      allow create: if isApproved()
                    && request.resource.data.keys().hasOnly(['uid', 'userName', 'date', 'litres', 'montant', 'plaque', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.date is string && request.resource.data.date.size() == 10
                    && request.resource.data.litres is number && request.resource.data.litres > 0 && request.resource.data.litres <= 500
                    && request.resource.data.montant is number && request.resource.data.montant > 0 && request.resource.data.montant <= 2000
                    && request.resource.data.plaque is string && request.resource.data.plaque.size() >= 4 && request.resource.data.plaque.size() <= 12
                    && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
    }
    match /pleinsPhotos/{pleinId} {
      allow read: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
      allow create: if isApproved()
                    && request.resource.data.keys().hasOnly(['uid', 'photo', 'createdAt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.photo is string
                    && request.resource.data.photo.matches('^data:image/jpeg;base64,.*');
      allow delete: if isAdmin() || (isApproved() && resource.data.uid == request.auth.uid);
    }

    // MESSAGERIE : la nouvelle messagerie (groupes, réactions, « Vu ») fonctionne avec les règles habituelles
    // « réservé aux participants ». Rien à changer si les règles actuelles ressemblent à :
    //   match /chats/{chatId} { allow read, update: if request.auth.uid in resource.data.participants;
    //                           allow create: if request.auth.uid in request.resource.data.participants;
    //     match /messages/{id} { allow read, write: if request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants; } }

    // PHOTOS AVANT / APRÈS : le lien de la photo est enregistré dans le pointage (champ « photos »), modifié
    // par son propriétaire : rien à changer si chacun peut déjà modifier ses propres pointages.
    // Les fichiers eux-mêmes sont protégés par storage.rules (à déployer, voir docs/DEPLOIEMENT-FIREBASE.md).

    // POINTAGES PRIVÉS (facultatif, NON activé) : dans la Pointeuse LPF, un employé ne lit plus que ses
    // pointages et ceux où il est noté comme équipier. Avec les profils partagés, la suggestion « tu étais
    // avec lui ? » cherche le nom du PROFIL dans « colleagues » : la règle devrait tenir compte de tous les
    // profils du compte. À tester dans le simulateur de règles avant de l'activer, sinon l'accueil peut casser.
